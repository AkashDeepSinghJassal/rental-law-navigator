# Copy to .env. API keys can live here or in your shell environment (shell wins).
# NOT LEGAL ADVICE: this tool explains housing law; it does not give legal advice.

# --- LLM provider (switch here) -------------------------------------------
# anthropic | openai | gemini | groq | ollama
LLM_PROVIDER=anthropic
# Leave empty to use the provider default:
#   anthropic -> claude-opus-5-5     gemini -> gemini-flash-latest
#   openai    -> gpt-5               groq   -> openai/gpt-oss-120b
#   ollama    -> llama3.3
LLM_MODEL=
# anthropic only: low | medium | high | xhigh | max
LLM_EFFORT=high
LLM_MAX_PARALLEL=4

# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# GROQ_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434/v1

# --- Storage ---------------------------------------------------------------
# SQLite by default; any SQLAlchemy URL works, e.g. postgresql+psycopg://user:pw@host/db
DATABASE_URL=sqlite:///data/navigator.db

# 1 = never call an LLM or the geocoder; fail on cache miss (replay mode)
NAVIGATOR_OFFLINE=0
